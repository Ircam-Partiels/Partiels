cmake_minimum_required(VERSION 3.10)

# Usage:
#   cmake -DKEYS_FILE=<keys_file> -DTRANS_FILE=<translation_file> -P TranslationKeysChecker.cmake
#
# Arguments:
#   KEYS_FILE   - File containing the reference list of quoted translation keys (one per line), generated by TranslationKeysExtractor.cmake with QUOTED_KEY_LIST=ON
#   TRANS_FILE  - Translation file to check
#
# Fails if the translation file has missing, obsolete, duplicated, empty or malformed translations.

# --- Validate arguments ---
if(NOT DEFINED KEYS_FILE)
    message(FATAL_ERROR "KEYS_FILE is required. Usage: cmake -DKEYS_FILE=<keys_file> -DTRANS_FILE=<translation_file> -P TranslationKeysChecker.cmake")
endif()
if(NOT DEFINED TRANS_FILE)
    message(FATAL_ERROR "TRANS_FILE is required. Usage: cmake -DKEYS_FILE=<keys_file> -DTRANS_FILE=<translation_file> -P TranslationKeysChecker.cmake")
endif()
if(NOT EXISTS "${KEYS_FILE}")
    message(FATAL_ERROR "Keys file not found: ${KEYS_FILE}")
endif()
if(NOT EXISTS "${TRANS_FILE}")
    message(FATAL_ERROR "Translation file not found: ${TRANS_FILE}")
endif()

get_filename_component(_trans_name "${TRANS_FILE}" NAME)

# --- Read key file ---
file(STRINGS "${KEYS_FILE}" KEY_LINES ENCODING UTF-8)

# --- Read translation file ---
file(STRINGS "${TRANS_FILE}" TRANS_LINES ENCODING UTF-8)
list(LENGTH TRANS_LINES _trans_length)
if(_trans_length LESS 2)
    message(FATAL_ERROR "${_trans_name}: the file must start with the 'language:' and 'countries:' lines.")
endif()
list(GET TRANS_LINES 0 _language_line)
list(GET TRANS_LINES 1 _countries_line)
if(NOT _language_line MATCHES "^language:" OR NOT _countries_line MATCHES "^countries:")
    message(FATAL_ERROR "${_trans_name}: the file must start with the 'language:' and 'countries:' lines.")
endif()
list(REMOVE_AT TRANS_LINES 0 1)

set(_error_count 0)
set(_trans_keys "")
foreach(_line IN LISTS TRANS_LINES)
    if("${_line}" STREQUAL "")
        continue()
    endif()
    if(NOT "${_line}" MATCHES "^(\".*\") = \"(.*)\"$")
        message(SEND_ERROR "${_trans_name}: malformed line: ${_line}")
        math(EXPR _error_count "${_error_count}+1")
        continue()
    endif()
    set(_key "${CMAKE_MATCH_1}")
    set(_value "${CMAKE_MATCH_2}")
    list(FIND _trans_keys "${_key}" _index)
    if(_index GREATER -1)
        message(SEND_ERROR "${_trans_name}: duplicated translation: ${_key}")
        math(EXPR _error_count "${_error_count}+1")
        continue()
    endif()
    list(APPEND _trans_keys "${_key}")
    list(FIND KEY_LINES "${_key}" _index)
    if(_index EQUAL -1)
        message(SEND_ERROR "${_trans_name}: obsolete translation (the key is no longer used in the sources): ${_key}")
        math(EXPR _error_count "${_error_count}+1")
    elseif("${_value}" STREQUAL "")
        message(SEND_ERROR "${_trans_name}: empty translation: ${_key}")
        math(EXPR _error_count "${_error_count}+1")
    endif()
endforeach()

foreach(_key IN LISTS KEY_LINES)
    if("${_key}" STREQUAL "")
        continue()
    endif()
    list(FIND _trans_keys "${_key}" _index)
    if(_index EQUAL -1)
        message(SEND_ERROR "${_trans_name}: missing translation: ${_key}")
        math(EXPR _error_count "${_error_count}+1")
    endif()
endforeach()

if(_error_count GREATER 0)
    message(FATAL_ERROR "${_trans_name}: ${_error_count} translation error(s). Update the file with the PartielsUpdateTranslation targets and fill the missing translations.")
endif()
message(STATUS "${_trans_name}: translations are up to date.")
