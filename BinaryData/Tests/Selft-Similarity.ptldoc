                     sdifFrameSignature="????" sdifMatrixSignature="????"/>
    <description name="Fast Fourier Transform" inputDomain="0" maker="Ircam" version="8"
                 category="Visualisation" details="Computes the classic spectrogram of the signal with the SuperVP Short-Time Fourier Transform (STFT): the signal is divided into overlapping frames weighted by the analysis window and the amplitude spectrum of each frame is returned in dB. The Window Duration sets the trade-off between the frequency resolution and the time resolution, the Window Overlapping sets the time density of the frames and the FFT Oversampling sets the number of frequency bins (the FFT size is the next power of two of the window size multiplied by the oversampling factor, the number of bins is half the FFT size plus one)."
                 copyright="Copyright 2024 Ircam. All rights reserved. Plugin by Pierre Guillot and Matthew Harris. SuperVP by Axel R&#246;bel and Fr&#233;d&#233;ric Cornu.">
      <defaultState blockSize="64" stepSize="0" windowType="3">
        <parameters key="fftoversampling" value="0.0"/>
        <parameters key="windowduration" value="23.21995544433594"/>
        <parameters key="windowoverlapping" value="1.0"/>
        <parameters key="windowtype" value="1.0"/>
      </defaultState>
      <parameters>
        <value identifier="windowtype" name="Window Type" description="The shape of the analysis window applied to each frame before the FFT. Blackman has the lowest side lobes (better detection of weak components close to strong ones) but a wider main lobe than Hanning and Hamming (lower frequency resolution)."
               unit="" minValue="0.0" maxValue="2.0" defaultValue="1.0" isQuantized="1"
               quantizeStep="1.0" isAlias="0">
          <valueNames value="Blackman"/>
          <valueNames value="Hanning"/>
          <valueNames value="Hamming"/>
        </value>
      </parameters>
      <parameters>
        <value identifier="windowsize" name="Window Size" description="The size of the analysis window in samples. It is an alias of the Window Duration parameter (the conversion depends on the sample rate). Larger windows improve the frequency resolution but reduce the time resolution."
               unit="samples" minValue="64.0" maxValue="48000.0" defaultValue="1115.0"
               isQuantized="1" quantizeStep="1.0" isAlias="1"/>
      </parameters>
      <parameters>
        <value identifier="windowduration" name="Window Duration" description="The duration of the analysis window in milliseconds. Larger windows improve the frequency resolution (separation of components close in frequency, low frequencies) but reduce the time resolution (fast variations, attacks), and conversely. The window is at least 64 samples long. The default value corresponds to 1024 samples at 44.1 kHz."
               unit="ms" minValue="0.3333333432674408" maxValue="1000.0" defaultValue="23.21995544433594"
               isQuantized="0" quantizeStep="0.0" isAlias="0"/>
      </parameters>
      <parameters>
        <value identifier="windowoverlapping" name="Window Overlapping" description="The minimum overlapping factor of the analysis windows: the hop size between two consecutive analysis frames is at most the window size divided by this factor. Higher factors increase the time density of the results at a higher computational cost."
               unit="x" minValue="0.0" maxValue="4.0" defaultValue="1.0" isQuantized="1"
               quantizeStep="1.0" isAlias="0">
          <valueNames value="3"/>
          <valueNames value="4"/>
          <valueNames value="8"/>
          <valueNames value="16"/>
          <valueNames value="32"/>
        </value>
      </parameters>
      <parameters>
        <value identifier="fftoversampling" name="FFT Oversampling" description="The FFT oversampling factor (zero-padding): the FFT size is the next power of two of the window size multiplied by this factor. Higher factors increase the number of frequency bins and improve the precision of the estimation of the spectral peaks without changing the time resolution, at a higher computational cost."
               unit="x" minValue="0.0" maxValue="3.0" defaultValue="0.0" isQuantized="1"
               quantizeStep="1.0" isAlias="0">
          <valueNames value="1"/>
          <valueNames value="2"/>
          <valueNames value="4"/>
          <valueNames value="8"/>
        </value>
      </parameters>
      <output identifier="spectrogram" name="Spectrogram" description="The amplitude in dB of the frequency bins of each analysis frame (from 0 Hz to the Nyquist frequency), clipped between -120 dB and 0 dB"
              unit="dB" hasFixedBinCount="1" binCount="4097" hasKnownExtents="1"
              minValue="-120.0" maxValue="0.0" isQuantized="0" quantizeStep="0.0"
              sampleType="2" sampleRate="0.0" hasDuration="0">
