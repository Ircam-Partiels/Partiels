---
// Replaces the hero of Starlight (only used by the home page) to display the IRCAM logo above the image
// and the latest release below the actions. The layout and the styles follow the original component.
import { LinkButton } from '@astrojs/starlight/components';
import IrcamLogo from './IrcamLogo.astro';
import LatestRelease from './LatestRelease.astro';
import { withBase } from '../lib/paths';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const imageFile = image && 'file' in image ? image.file : undefined;

// The relative links of the actions are resolved from the base path, so that they also work when the URL of the
// home page has no trailing slash (as served by the development and preview servers).
const resolve = (link: string) => (/^([a-z]+:|\/|#)/i.test(link) ? link : withBase(link));
---

<div class="hero">
	<div class="sl-flex media">
		<IrcamLogo width="11rem" />
		{
			imageFile && (
				<div class="hero-image sl-flex">
					<img src={imageFile.src} alt={image?.alt ?? ''} width={imageFile.width} height={imageFile.height} />
				</div>
			)
		}
	</div>
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		<div class="sl-flex actions">
			{
				actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
					<LinkButton href={resolve(href)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))
			}
		</div>
		<LatestRelease class="release" />
	</div>
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 1rem;
		padding-bottom: 1rem;
	}

	.hero > .media {
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		width: min(100%, 40rem);
		margin-inline: auto;
	}

	.hero-image img {
		max-width: 100%;
		height: auto;
		border-radius: 0.5rem;
		box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.35);
	}

	.stack {
		flex-direction: column;
		gap: clamp(1.25rem, calc(1.25rem + 1vw), 1.75rem);
		text-align: center;
		align-items: center;
	}

	.copy {
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.copy > * {
		max-width: 50ch;
	}

	h1 {
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}

	.actions {
		gap: 1rem 1.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.release {
		margin: 0;
		color: var(--sl-color-gray-2);
	}

	.release :global(a) {
		color: var(--sl-color-text-accent);
	}

	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 7fr 5fr;
			gap: 3%;
			padding-block: clamp(2rem, calc(1rem + 6vmin), 6rem);
		}

		.hero > .media {
			order: 2;
			align-items: flex-end;
		}

		.stack,
		.copy {
			text-align: start;
			align-items: flex-start;
		}

		.actions {
			justify-content: flex-start;
		}
	}
</style>
